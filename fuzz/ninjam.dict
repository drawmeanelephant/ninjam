# NINJAM wire protocol tokens for libFuzzer
#
type0x80="\x80"
type0x81="\x81"
type0x82="\x82"
type0x83="\x83"
type0x84="\x84"
type0xc0="\xc0"
type0xfd="\xfd"
type0xfe="\xfe"
type0xff="\xff"
# declared sizes: empty, tiny, overlong (max+1), max
size0="\x00\x00\x00\x00"
size1="\x01\x00\x00\x00"
size17="\x11\x00\x00\x00"
size25="\x19\x00\x00\x00"
size4001="\xa1\x0f\x00\x00"
sizemax="\x00\x40\x00\x00"
# mpb_client_auth_user fields
passhash20="\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01"
capslicense="\x03\x00\x02\x00"
vercur="\x00\x00\x02\x00"
vermin="\x00\x00\x02\x00"
vermax="\xff\xff\x02\x00"
verbad="\x00\x00\x01\x00"
useranon="anon"
useranonpre="anonymous:"
# channel info
mpisize4="\x04\x00"
mpisize0="\x00\x00"
mpisize65535="\xff\xff"
# fourcc values
fourcc_oggv="OGGv"
fourcc_oggx="OGGx"
